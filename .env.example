# Base URL for DemoQA
BASE_URL=https://demoqa.com

# Browser settings
BROWSER=chromium
HEADLESS=true
SLOW_MO=0

# Tracing: "on_failure" | "always" | "off"
TRACE_MODE=on_failure

# Book Store test user (created via API fixture on first run)
BOOKSTORE_USERNAME=
BOOKSTORE_PASSWORD=

# Set to pw:api to enable verbose Playwright API logs
# DEBUG=pw:api
